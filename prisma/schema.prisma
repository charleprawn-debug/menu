// DineFlow — Multi-Tenant Restaurant Operating System (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DELETED
}

enum PlatformRole {
  SUPER_ADMIN
  ADMIN
  FINANCE_ADMIN
  SUPPORT_AGENT
  MARKETING_ADMIN
  TECHNICAL_ADMIN
  READ_ONLY_ADMIN
}

enum RestaurantStatus {
  DRAFT
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum PermissionScope {
  RESTAURANT
  BRANCH
  OWNED
}

enum OrderType {
  DINE_IN
  PICKUP
  DELIVERY
}

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  DELIVERED
  COMPLETED
  REJECTED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PARTIALLY_PAID
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
  WALLET
  BANK_TRANSFER
  PAY_AT_PICKUP
  PAY_ON_DELIVERY
  OTHER
}

enum PaymentTxStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
  REFUNDED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  DISABLED
}

enum TableShape {
  ROUND
  SQUARE
  RECTANGLE
  BOOTH
  BAR
}

enum SessionStatus {
  OPEN
  CLOSED
  MERGED
}

enum QrType {
  TABLE
  MENU
  PICKUP
  DELIVERY
  CAMPAIGN
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  NO_SHOW
  CANCELLED
  COMPLETED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum KitchenStationType {
  KITCHEN
  BAR
  GRILL
  DESSERT
  CUSTOM
}

enum KitchenTicketStatus {
  QUEUED
  PREPARING
  DELAYED
  READY
  SERVED
  CANCELLED
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ShiftStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  BROWSER
  SMS
  WEBHOOK
}

enum NotificationType {
  ORDER_NEW
  ORDER_STATUS
  ORDER_CANCELLED
  RESERVATION_NEW
  RESERVATION_STATUS
  WAITER_CALL
  PAYMENT
  SUBSCRIPTION
  SYSTEM
  ANNOUNCEMENT
  REVIEW
  STOCK
}

enum ProductAvailability {
  ALWAYS
  SCHEDULED
  OUT_OF_STOCK
  HIDDEN
}

enum MenuStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DomainStatus {
  PENDING
  VERIFIED
  ACTIVE
  FAILED
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
  WASTE
  TRANSFER
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum AiActionStatus {
  PROPOSED
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

enum DeliveryStatus {
  UNASSIGNED
  ASSIGNED
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  FAILED
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  pendingEmail    String?      @unique
  passwordHash    String?
  name            String
  phone           String?
  avatarUrl       String?
  locale          String       @default("ar")
  status          UserStatus   @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  isPlatformAdmin Boolean      @default(false)
  platformRole    PlatformRole?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  memberships      RestaurantMember[]
  ownedRestaurants Restaurant[]       @relation("RestaurantOwner")
  sessions         Session[]
  notifications    Notification[]
  reviews          CustomerReview[]
  loyaltyAccounts  LoyaltyAccount[]
  supportTickets   SupportTicket[]
  supportMessages  SupportMessage[]
  aiConversations  AiConversation[]
  auditLogs        PlatformAuditLog[]
  activityLogs     StaffActivityLog[]
  emailChangeTokens EmailChangeToken[]
  ordersCreated    Order[]            @relation("OrderCreatedBy")

  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model EmailChangeToken {
  id        String    @id @default(cuid())
  userId    String
  restaurantId String
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([newEmail])
  @@map("email_change_tokens")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurants Restaurant[]

  @@map("organizations")
}

model Restaurant {
  id                    String           @id @default(cuid())
  organizationId        String?
  ownerId               String
  slug                  String           @unique
  name                  String
  legalName             String?
  description           String?          @db.Text
  cuisineType           String?
  phone                 String?
  email                 String?
  website               String?
  country               String?
  city                  String?
  address               String?          @db.Text
  latitude              Float?
  longitude             Float?
  currency              String           @default("USD")
  timezone              String           @default("Asia/Riyadh")
  defaultLocale         String           @default("ar")
  logoUrl               String?
  coverUrl              String?
  primaryColor          String           @default("#059669")
  secondaryColor        String           @default("#0f172a")
  fontFamily            String           @default("IBM Plex Sans Arabic")
  menuLayout            String           @default("grid")
  status                RestaurantStatus @default(DRAFT)
  onboardingStep        Int              @default(1)
  onboardingCompletedAt DateTime?
  trialEndsAt           DateTime?
  settings              Json             @default("{}")
  menuTheme             Json             @default("{}")
  floorPlan             Json             @default("{}")
  openingHours          Json             @default("{}")
  orderSettings         Json             @default("{}")
  paymentSettings       Json             @default("{}")
  notificationSettings  Json             @default("{}")
  reservationSettings   Json             @default("{}")
  seo                   Json             @default("{}")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id])
  owner        User          @relation("RestaurantOwner", fields: [ownerId], references: [id])

  branches     Branch[]
  members      RestaurantMember[]
  roles        Role[]
  staffInvitations StaffInvitation[]
  emailChangeTokens EmailChangeToken[]
  categories   MenuCategory[]
  products     Product[]
  menus        Menu[]
  areas        RestaurantArea[]
  tables       Table[]
  orders       Order[]
  kitchenStations KitchenStation[]
  mediaAssets  RestaurantMedia[]
  subscription Subscription?

  @@index([ownerId])
  @@index([status])
  @@map("restaurants")
}

model RestaurantMedia {
  id           String   @id @default(cuid())
  restaurantId String
  kind         String
  contentType  String
  data         Bytes    @db.ByteA
  sizeBytes    Int
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, kind])
  @@map("restaurant_media")
}

model Branch {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  code         String?
  phone        String?
  email        String?
  address      String?  @db.Text
  city         String?
  country      String?
  timezone     String?
  currency     String?
  managerId    String?
  isMain       Boolean  @default(false)
  isActive     Boolean  @default(true)
  openingHours Json     @default("{}")
  settings     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  members    RestaurantMember[]
  memberAccess MemberBranchAccess[]
  invitations StaffInvitation[]
  invitationAccess StaffInvitationBranch[]
  activityLogs StaffActivityLog[]
  tables     Table[]

  @@index([restaurantId])
  @@map("branches")
}

model RestaurantMember {
  id           String       @id @default(cuid())
  restaurantId String
  userId       String
  branchId     String?
  title        String?
  status       MemberStatus @default(ACTIVE)
  isOwner      Boolean      @default(false)
  invitedById  String?
  invitedAt    DateTime?
  joinedAt     DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  restaurant  Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch      Branch?            @relation(fields: [branchId], references: [id])
  branchAccess MemberBranchAccess[]
  roles       MemberRole[]
  permissions MemberPermission[]

  @@unique([restaurantId, userId])
  @@index([userId])
  @@map("restaurant_members")
}

model Role {
  id           String   @id @default(cuid())
  restaurantId String?
  key          String
  name         String
  nameEn       String?
  description  String?
  isSystem     Boolean  @default(false)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant  Restaurant?      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  members     MemberRole[]
  invitations StaffInvitation[]

  @@unique([restaurantId, key])
  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  group       String
  labelAr     String
  labelEn     String
  description String?
  isSensitive Boolean @default(false)

  roles             RolePermission[]
  memberPermissions MemberPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  scope        PermissionScope @default(RESTAURANT)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MemberRole {
  memberId String
  roleId   String

  member RestaurantMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@map("member_roles")
}

model MemberBranchAccess {
  memberId   String
  branchId   String
  assignedAt DateTime @default(now())

  member RestaurantMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  branch Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([memberId, branchId])
  @@index([branchId])
  @@map("member_branch_access")
}

model MemberPermission {
  id           String           @id @default(cuid())
  memberId     String
  permissionId String
  effect       PermissionEffect @default(ALLOW)
  scope        PermissionScope  @default(RESTAURANT)

  member     RestaurantMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  permission Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([memberId, permissionId])
  @@map("member_permissions")
}

model Menu {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  type         String     @default("MAIN")
  status       MenuStatus @default(DRAFT)
  isDefault    Boolean    @default(false)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  schedules  MenuSchedule[]

  @@index([restaurantId])
  @@map("menus")
}

model MenuCategory {
  id            String    @id @default(cuid())
  restaurantId  String
  menuId        String?
  parentId      String?
  nameAr        String
  nameEn        String?
  description   String?   @db.Text
  imageUrl      String?
  coverUrl      String?
  sortOrder     Int       @default(0)
  isVisible     Boolean   @default(true)
  availableFrom DateTime?
  availableTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  parent     MenuCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   MenuCategory[] @relation("CategoryTree")
  products   Product[]

  @@index([restaurantId])
  @@map("menu_categories")
}

model Product {
  id             String              @id @default(cuid())
  restaurantId   String
  categoryId     String?
  defaultStationId String?            @map("default_station_id")
  nameAr         String
  nameEn         String?
  descriptionAr  String?             @db.Text
  descriptionEn  String?             @db.Text
  sku            String?
  price          Decimal             @db.Decimal(12, 2)
  compareAtPrice Decimal?            @db.Decimal(12, 2)
  costPrice      Decimal?            @db.Decimal(12, 2)
  taxRate        Decimal             @default(0) @db.Decimal(5, 2)
  imageUrl       String?
  calories       Int?
  prepMinutes    Int                 @default(15)
  ingredients    String?             @db.Text
  allergens      String[]            @default([])
  tags           String[]            @default([])
  availability   ProductAvailability @default(ALWAYS)
  stockQty       Int?
  trackStock     Boolean             @default(false)
  isVisible      Boolean             @default(true)
  isFeatured     Boolean             @default(false)
  sortOrder      Int                 @default(0)
  soldCount      Int                 @default(0)
  rating         Float?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?

  restaurant     Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category       MenuCategory?         @relation(fields: [categoryId], references: [id])
  defaultStation KitchenStation?       @relation("ProductDefaultStation", fields: [defaultStationId], references: [id], onDelete: SetNull)
  images         ProductImage[]
  modifierGroups ProductModifierGroup[]
  extras         ProductExtra[]
  orderItems     OrderItem[]
  priceHistory   PriceHistory[]
  reviews        CustomerReview[]

  @@index([restaurantId])
  @@index([categoryId])
  @@index([defaultStationId])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ModifierGroup {
  id           String   @id @default(cuid())
  restaurantId String
  nameAr       String
  nameEn       String?
  description  String?
  isRequired   Boolean  @default(false)
  minSelect    Int      @default(0)
  maxSelect    Int      @default(1)
  isMultiple   Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  options  ModifierOption[]
  products ProductModifierGroup[]

  @@index([restaurantId])
  @@map("modifier_groups")
}

model ModifierOption {
  id          String  @id @default(cuid())
  groupId     String
  nameAr      String
  nameEn      String?
  priceDelta  Decimal @default(0) @db.Decimal(12, 2)
  isDefault   Boolean @default(false)
  isAvailable Boolean @default(true)
  sortOrder   Int     @default(0)

  group ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("modifier_options")
}

model ProductModifierGroup {
  productId String
  groupId   String
  sortOrder Int    @default(0)

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
  @@map("product_modifier_groups")
}

model Extra {
  id           String   @id @default(cuid())
  restaurantId String
  nameAr       String
  nameEn       String?
  price        Decimal  @default(0) @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  products ProductExtra[]

  @@index([restaurantId])
  @@map("extras")
}

model ProductExtra {
  productId String
  extraId   String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  extra   Extra   @relation(fields: [extraId], references: [id], onDelete: Cascade)

  @@id([productId, extraId])
  @@map("product_extras")
}

model MenuSchedule {
  id        String    @id @default(cuid())
  menuId    String
  dayOfWeek Int?
  startTime String?
  endTime   String?
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean   @default(true)

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
  @@map("menu_schedules")
}

model MenuTheme {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  previewUrl  String?
  config      Json     @default("{}")
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("menu_themes")
}

model PriceHistory {
  id          String   @id @default(cuid())
  productId   String
  oldPrice    Decimal  @db.Decimal(12, 2)
  newPrice    Decimal  @db.Decimal(12, 2)
  changedById String?
  reason      String?
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("price_history")
}

model RestaurantArea {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  color        String   @default("#e2e8f0")
  sortOrder    Int      @default(0)
  layout       Json     @default("{}")
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables     Table[]

  @@index([restaurantId])
  @@map("restaurant_areas")
}

model Table {
  id             String      @id @default(cuid())
  restaurantId   String
  branchId       String?
  areaId         String?
  number         String
  name           String?
  seats          Int         @default(2)
  shape          TableShape  @default(SQUARE)
  status         TableStatus @default(AVAILABLE)
  allowSelfOrder Boolean     @default(true)
  notes          String?
  positionX      Float       @default(0)
  positionY      Float       @default(0)
  width          Float       @default(100)
  height         Float       @default(100)
  rotation       Float       @default(0)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  restaurant  Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch      Branch?         @relation(fields: [branchId], references: [id])
  area        RestaurantArea? @relation(fields: [areaId], references: [id])
  qrCodes     TableQrCode[]
  sessions    TableSession[]
  orders      Order[]
  waiterCalls WaiterCall[]
  reservations Reservation[]

  @@unique([restaurantId, number])
  @@index([restaurantId])
  @@map("tables")
}

model TableQrCode {
  id           String   @id @default(cuid())
  restaurantId String
  tableId      String?
  code         String   @unique
  type         QrType   @default(TABLE)
  label        String?
  targetUrl    String?
  isActive     Boolean  @default(true)
  scanCount    Int      @default(0)
  expiresAt    DateTime?
  createdAt    DateTime @default(now())

  table Table? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@map("table_qr_codes")
}

model TableSession {
  id           String        @id @default(cuid())
  restaurantId String
  tableId      String
  code         String        @unique
  guests       Int           @default(1)
  status       SessionStatus @default(OPEN)
  openedById   String?
  closedById   String?
  openedAt     DateTime      @default(now())
  closedAt     DateTime?
  notes        String?
  total        Decimal       @default(0) @db.Decimal(12, 2)

  table      Table               @relation(fields: [tableId], references: [id], onDelete: Cascade)
  orders     Order[]
  guestsList TableSessionGuest[]

  @@index([restaurantId])
  @@index([tableId])
  @@map("table_sessions")
}

model TableSessionGuest {
  id        String  @id @default(cuid())
  sessionId String
  name      String?
  phone     String?
  isPrimary Boolean @default(false)

  session TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("table_session_guests")
}

model WaiterCall {
  id           String    @id @default(cuid())
  restaurantId String
  tableId      String
  type         String    @default("WAITER")
  note         String?
  status       String    @default("PENDING")
  handledById  String?
  createdAt    DateTime  @default(now())
  handledAt    DateTime?

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@map("waiter_calls")
}

model Order {
  id              String         @id @default(cuid())
  restaurantId    String
  branchId        String?
  orderNumber     Int
  type            OrderType      @default(DINE_IN)
  status          OrderStatus    @default(NEW)
  tableId         String?
  sessionId       String?
  customerId      String?
  customerName    String?
  customerPhone   String?
  deliveryAddress String?        @db.Text
  deliveryArea    String?
  deliveryNotes   String?
  pickupAt        DateTime?
  scheduledFor    DateTime?
  itemsCount      Int            @default(0)
  subtotal        Decimal        @default(0) @db.Decimal(12, 2)
  discount        Decimal        @default(0) @db.Decimal(12, 2)
  tax             Decimal        @default(0) @db.Decimal(12, 2)
  serviceFee      Decimal        @default(0) @db.Decimal(12, 2)
  deliveryFee     Decimal        @default(0) @db.Decimal(12, 2)
  tip             Decimal        @default(0) @db.Decimal(12, 2)
