  status        TicketStatus   @default(OPEN)
  assignedToId  String?
  attachmentUrl String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  closedAt      DateTime?

  requester User             @relation(fields: [requesterId], references: [id])
  messages  SupportMessage[]

  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id            String   @id @default(cuid())
  ticketId      String
  authorId      String?
  body          String   @db.Text
  isInternal    Boolean  @default(false)
  attachmentUrl String?
  createdAt     DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorId], references: [id])

  @@index([ticketId])
  @@map("support_messages")
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String    @db.Text
  audience    String    @default("ALL")
  channel     String    @default("IN_APP")
  status      String    @default("DRAFT")
  scheduledAt DateTime?
  sentAt      DateTime?
  createdById String?
  stats       Json      @default("{}")
  createdAt   DateTime  @default(now())

  @@map("announcements")
}

model CustomDomain {
  id            String       @id @default(cuid())
  restaurantId  String
  domain        String       @unique
  status        DomainStatus @default(PENDING)
  sslStatus     String       @default("PENDING")
  isPrimary     Boolean      @default(false)
  verifiedAt    DateTime?
  lastCheckedAt DateTime?
  createdAt     DateTime     @default(now())

  @@index([restaurantId])
  @@map("custom_domains")
}

model Integration {
  id           String   @id @default(cuid())
  restaurantId String?
  provider     String
  name         String
  config       Json     @default("{}")
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("integrations")
}

model Webhook {
  id           String    @id @default(cuid())
  restaurantId String
  url          String
  secret       String
  events       String[]  @default([])
  isActive     Boolean   @default(true)
  lastStatus   Int?
  lastCalledAt DateTime?
  createdAt    DateTime  @default(now())

  deliveries WebhookDelivery[]

  @@index([restaurantId])
  @@map("webhooks")
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  payload    Json
  statusCode Int?
  response   String?  @db.Text
  createdAt  DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@map("webhook_deliveries")
}

model AutomationRule {
  id           String    @id @default(cuid())
  restaurantId String
  name         String
  trigger      String
  conditions   Json      @default("{}")
  actions      Json      @default("[]")
  isActive     Boolean   @default(true)
  runCount     Int       @default(0)
  lastRunAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([restaurantId])
  @@map("automation_rules")
}

model AutomationRun {
  id        String   @id @default(cuid())
  ruleId    String
  status    String   @default("SUCCESS")
  log       String?  @db.Text
  createdAt DateTime @default(now())

  @@index([ruleId])
  @@map("automation_runs")
}

model Notification {
  id           String              @id @default(cuid())
  userId       String?
  restaurantId String?
  type         NotificationType    @default(SYSTEM)
  title        String
  body         String?
  data         Json                @default("{}")
  channel      NotificationChannel @default(IN_APP)
  isRead       Boolean             @default(false)
  readAt       DateTime?
  createdAt    DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model NotificationPreference {
  id           String           @id @default(cuid())
  userId       String
  restaurantId String?
  type         NotificationType
  inApp        Boolean          @default(true)
  email        Boolean          @default(true)
  browser      Boolean          @default(false)
  sms          Boolean          @default(false)

  @@unique([userId, restaurantId, type])
  @@map("notification_preferences")
}

model NotificationTemplate {
  id       String              @id @default(cuid())
  key      String              @unique
  channel  NotificationChannel @default(IN_APP)
  subject  String?
  bodyAr   String              @db.Text
  bodyEn   String              @db.Text
  isActive Boolean             @default(true)

  @@map("notification_templates")
}

model NotificationLog {
  id             String   @id @default(cuid())
  notificationId String?
  channel        String
  recipient      String
  status         String   @default("SENT")
  error          String?
  sentAt         DateTime @default(now())

  @@index([notificationId])
  @@map("notification_logs")
}

model InventoryCategory {
  id           String @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int    @default(0)

  items InventoryItem[]

  @@index([restaurantId])
  @@map("inventory_categories")
}

model InventoryItem {
  id           String   @id @default(cuid())
  restaurantId String
  categoryId   String?
  supplierId   String?
  name         String
  sku          String?
  unit         String   @default("pcs")
  quantity     Decimal  @default(0) @db.Decimal(12, 3)
  minQuantity  Decimal  @default(0) @db.Decimal(12, 3)
  costPerUnit  Decimal  @default(0) @db.Decimal(12, 3)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category          InventoryCategory?  @relation(fields: [categoryId], references: [id])
  movements         StockMovement[]
  recipeIngredients RecipeIngredient[]

  @@index([restaurantId])
  @@map("inventory_items")
}

model Supplier {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  contactName  String?
  phone        String?
  email        String?
  address      String?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  purchaseOrders PurchaseOrder[]

  @@index([restaurantId])
  @@map("suppliers")
}

model StockMovement {
  id           String               @id @default(cuid())
  restaurantId String
  itemId       String
  type         InventoryMovementType
  quantity     Decimal              @db.Decimal(12, 3)
  unitCost     Decimal?             @db.Decimal(12, 3)
  reason       String?
  reference    String?
  createdById  String?
  createdAt    DateTime             @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("stock_movements")
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  restaurantId String
  supplierId   String?
  number       String
  status       PurchaseOrderStatus @default(DRAFT)
  total        Decimal             @default(0) @db.Decimal(12, 2)
  expectedAt   DateTime?
  receivedAt   DateTime?
  notes        String?
  createdById  String?
  createdAt    DateTime            @default(now())

  supplier Supplier?           @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]

  @@unique([restaurantId, number])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  itemId          String?
  name            String
  quantity        Decimal @db.Decimal(12, 3)
  unitCost        Decimal @db.Decimal(12, 3)
  total           Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

model Recipe {
  id           String   @id @default(cuid())
  restaurantId String
  productId    String
  name         String
  yieldQty     Decimal  @default(1) @db.Decimal(12, 3)
  notes        String?
  createdAt    DateTime @default(now())

  ingredients RecipeIngredient[]

  @@index([restaurantId])
  @@map("recipes")
}

model RecipeIngredient {
  id       String  @id @default(cuid())
  recipeId String
  itemId   String
  quantity Decimal @db.Decimal(12, 3)

  recipe Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("recipe_ingredients")
}

model AiConversation {
  id           String   @id @default(cuid())
  restaurantId String
  userId       String
  title        String   @default("New conversation")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([restaurantId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String   @db.Text
  tokens         Int      @default(0)
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model AiUsageLog {
  id               String   @id @default(cuid())
  restaurantId     String
  userId           String?
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  cost             Decimal  @default(0) @db.Decimal(12, 4)
  createdAt        DateTime @default(now())

  @@index([restaurantId])
  @@map("ai_usage_logs")
}

model AiAction {
  id               String         @id @default(cuid())
  restaurantId     String
  conversationId   String?
  messageId        String?
  type             String
  payload          Json           @default("{}")
  status           AiActionStatus @default(PROPOSED)
  requiresApproval Boolean        @default(true)
  approvedById     String?
  executedAt       DateTime?
  createdAt        DateTime       @default(now())

  approvals AiActionApproval[]

  @@index([restaurantId])
  @@map("ai_actions")
}

model AiActionApproval {
  id        String   @id @default(cuid())
  actionId  String
  userId    String
  decision  String
  note      String?
  createdAt DateTime @default(now())

  action AiAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@map("ai_action_approvals")
}

model BillingProviderEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  result      String    @default("RECEIVED")
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([provider, receivedAt])
  @@map("billing_provider_events")
}
