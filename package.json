    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.3",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
