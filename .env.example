# ─── Database ───────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Neon, Railway, local...)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dineflow?schema=public"
# The demo seed truncates tables; remote non-production databases require explicit opt-in.
ALLOW_DESTRUCTIVE_DEMO_SEED="false"

# ─── Auth ───────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-secret"

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="DineFlow"
# Set NEXT_PUBLIC_APP_URL to the public HTTPS origin in deployment; set this true if an HTTPS
# preview origin must be used for cookies before the public app URL is available.
SESSION_COOKIE_SECURE="false"

# ─── Optional integrations ──────────────────────────────────
# OpenAI-compatible endpoint used by the AI Assistant (optional)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# SMTP (required for password-reset email delivery; without it, production does not send email)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="DineFlow <no-reply@dineflow.app>"

# Email verification is optional; set true only after SMTP is configured and tested.
EMAIL_VERIFICATION_REQUIRED="false"

# Billing is provider-neutral and disabled until an owner-selected adapter is installed/configured.
# Setting these values alone does not enable payments; do not set BILLING_ENABLED=true yet.
BILLING_ENABLED="false"
BILLING_PROVIDER="disabled"
# Local-subscription grace days after a missed period end (0-30; default 0).
BILLING_GRACE_DAYS="0"
# Protects POST /api/cron/subscriptions; call it from the production host scheduler with
# Authorization: Bearer <CRON_SECRET>. Generate with: openssl rand -hex 32
CRON_SECRET=""
